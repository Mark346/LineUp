rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Elke teamcode + pincode wordt in de app omgezet naar een lange, onraadbare sleutel (64 tekens).
    // Alleen wie die combinatie kent, kan de gegevens lezen en opslaan.
    match /clubs/{clubId} {
      allow get: if clubId.size() == 64;
      allow create, update: if clubId.size() == 64
                            && request.resource.data.data is string
                            && request.resource.data.data.size() < 900000;
      // Niemand mag een lijst van alle teams opvragen of iets verwijderen
      allow list, delete: if false;
    }
  }
}
